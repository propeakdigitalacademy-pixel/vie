modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "quality"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "native-evaluation"

[[workflows.workflow]]
name = "quality"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check && npm run format:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "native-evaluation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run evaluate"

[workflows.workflow.metadata]
isValidation = true
